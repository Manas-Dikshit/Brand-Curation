# Nothing here is required. The app is keyless: `npm i && npm run dev` just works.
# Every variable below is an optional tuning knob with a working default.

# Sheet in reference/Newtail_Brand_Curation_Matrix.xlsx that holds the approved weights.
REF_SHEET=Copy of Criteria & Weights

# Fetch tuning (defaults shown).
FETCH_TIMEOUT_MS=8000
PER_DOMAIN_GAP_MS=1000
GLOBAL_REQUEST_GAP_MS=100
BRAND_CONCURRENCY=6

# Opt-in JS rendering for pages that look like a bot wall. Needs playwright installed
# separately; without it the page is simply recorded as wall-suspected.
USE_PLAYWRIGHT=false